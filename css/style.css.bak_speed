}

.english, .flashcard .word, .clickable-word, pre, code, kbd {
  font-family: var(--font-en);
}

h2 { font-size: 1.5rem; }
h3 { font-size: 1.25rem; }
@import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&family=Inter:wght@400;500;600&display=swap');

:root {
  --font-ar: 'Tajawal', 'Segoe UI', sans-serif;
  --font-en: 'Inter', 'Segoe UI', Roboto, sans-serif;
  --font-size-base: 16px;
