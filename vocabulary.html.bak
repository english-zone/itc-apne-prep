<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vocabulary – ITC APNE Prep</title>
  <!-- Favicon – rocket emoji as SVG (works in all modern browsers) -->
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext x='50' y='70' font-size='70' text-anchor='middle'%3E🚀%3C/text%3E%3C/svg%3E">
  <!-- Google Fonts (Inter + Noto Sans Arabic) -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&family=Noto+Sans+Arabic:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
  <header class="app-header">
    <nav class="navbar" id="navbar"></nav>
    <div class="theme-toggle"><button id="themeToggle" aria-label="Toggle dark/light mode">🌓</button></div>
  </header>
  <main class="container">
    <section class="vocab-header">
      <h1>📝 Vocabulary Flashcards</h1>
      <div class="vocab-controls">
        <select id="vocabSetSelector" class="form-select"><option value="">-- Load a vocab set --</option></select>
        <div class="filter-btns">
          <button class="btn btn-sm btn-primary" data-filter="all">All</button>
          <button class="btn btn-sm" data-filter="learning">Learning</button>
          <button class="btn btn-sm" data-filter="weak">Weak</button>
          <button class="btn btn-sm" data-filter="known">Known</button>
        </div>
      </div>
    </section>
    <section id="flashcardContainer" class="flashcard-area">
      <div class="empty-state"><p>Load vocabulary sets from /content/vocabulary/</p></div>
    </section>
    <div id="wordDetailPopup" class="popup-overlay" style="display:none;">
      <div class="popup-card">
        <button class="popup-close">&times;</button>
        <div id="detailContent"></div>
      </div>
    </div>
  </main>
  <footer class="app-footer"><p>Vocabulary Engine – definitions from dictionary.json</p></footer>
  <script src="js/storage.js"></script>
  <script src="js/app.js"></script>
  <script src="js/vocabulary.js"></script>
</body>
</html>
